{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-aware-qa/schemas/surface-registry.json",
  "title": "Surface Registry",
  "description": "Machine-readable output of project-aware-qa: the inferred QA surface area of a repo.",
  "type": "object",
  "required": ["schema", "version", "generatedAt", "project", "surfaces", "stats"],
  "additionalProperties": true,
  "properties": {
    "schema": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["inputHash", "commit", "files", "complete"],
      "properties": {
        "inputHash": { "type": "string" },
        "commit": { "type": ["string", "null"] },
        "files": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project": {
      "type": "object",
      "required": ["root", "packageManager", "frameworks", "scripts", "stacks"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "packageManager": { "type": "string", "description": "Primary stack's package manager (npm/pnpm/yarn/bun/mix/go/cargo/pip/…)." },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "scripts": { "type": "object", "additionalProperties": { "type": "string" } },
        "testRunners": { "type": "array", "items": { "type": "string" } },
        "packageJsonPaths": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
        "stacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["adapter", "label", "language", "rootRel", "packageManager", "frameworks", "checks", "depth"],
            "properties": {
              "adapter": { "type": "string" },
              "label": { "type": "string" },
              "language": { "type": "string" },
              "rootRel": { "type": "string" },
              "packageManager": { "type": "string" },
              "frameworks": { "type": "array", "items": { "type": "string" } },
              "scripts": { "type": "object", "additionalProperties": { "type": "string" } },
              "testRunners": { "type": "array", "items": { "type": "string" } },
              "depth": { "enum": ["deep", "generic"] },
              "checks": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["command", "cwd"],
                  "properties": {
                    "command": { "type": "string" },
                    "cwd": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/definitions/surface" }
    },
    "stats": {
      "type": "object",
      "required": ["surfaces", "byType", "byRisk"],
      "properties": {
        "totalFiles": { "type": "number" },
        "scannedFiles": { "type": "number" },
        "surfaces": { "type": "number" },
        "byType": { "type": "object", "additionalProperties": { "type": "number" } },
        "byRisk": {
          "type": "object",
          "properties": {
            "high": { "type": "number" },
            "medium": { "type": "number" },
            "low": { "type": "number" }
          }
        }
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "file", "route", "endpoint", "form", "dto", "query",
            "mutation", "invalidation", "storage", "test", "script", "note"
          ]
        },
        "detail": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "number" }
      }
    },
    "inferredTest": {
      "type": "object",
      "required": ["kind", "description", "status"],
      "properties": {
        "kind": { "enum": ["smoke", "route", "form", "api", "cache", "screenshot", "e2e", "unit"] },
        "description": { "type": "string" },
        "status": { "enum": ["present", "missing", "unknown"] }
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "type", "title", "files", "risk", "riskScore", "riskReasons", "inferredTests", "evidence", "gaps"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["crud-flow", "form", "api-endpoint", "route", "cache-risk", "visual-page", "test-gap"]
        },
        "title": { "type": "string" },
        "entity": { "type": "string" },
        "frontendRoute": { "type": "string" },
        "backendEndpoint": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "risk": { "enum": ["high", "medium", "low"] },
        "riskScore": { "type": "number" },
        "riskReasons": { "type": "array", "items": { "type": "string" } },
        "inferredTests": { "type": "array", "items": { "$ref": "#/definitions/inferredTest" } },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
